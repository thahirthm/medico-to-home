# Copy to .env.local and fill in. See SUPABASE_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
DATABASE_URL=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Production only: the admin dashboard's own web address, e.g. admin.medicotohome.in. Leave empty locally.
ADMIN_HOST=
# Admin 2-step code. Set both to off only for local testing; leave on in production.
ADMIN_TWO_STEP=on
NEXT_PUBLIC_ADMIN_TWO_STEP=on
