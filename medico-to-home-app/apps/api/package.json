{
  "name": "@medico/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --external:pg-native --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node --env-file-if-exists=../../.env.local dist/server.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "@fastify/rate-limit": "^11.2.1",
    "@medico/shared": "*",
    "fastify": "^5",
    "pg": "^8",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "esbuild": "^0.25",
    "tsx": "^4",
    "vitest": "^3"
  }
}
