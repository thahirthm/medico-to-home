# Copy to /srv/medico/app/.env.local on the server and fill in. Never commit it.
# Replace medicotohome.in with your domain everywhere below.

# Supabase (same values as your local .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Where browsers reach the API
NEXT_PUBLIC_API_URL=https://api.medicotohome.in
# Where the website server reaches the API on the same machine
API_INTERNAL_URL=http://127.0.0.1:4000

API_PORT=4000
# Every site allowed to call the API, comma separated
WEB_ORIGIN=https://medicotohome.in,https://www.medicotohome.in,https://admin.medicotohome.in
# The admin dashboard's own address; /admin is hidden on the main site
ADMIN_HOST=admin.medicotohome.in
